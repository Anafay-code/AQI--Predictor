# Copy to .env and fill. All optional — system runs offline with synthetic data if unset.

# Real-time AQI (https://aqicn.org/data-platform/token/)
AQICN_API_TOKEN=

# Weather + history (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Cloud feature store + model registry (https://app.hopsworks.ai)
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=
